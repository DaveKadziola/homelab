{
  "newVersionCheck": {
    "enabled": false
  },
  "trash": {
    "enabled": true,
    "days": 30
  },
  "storageTemplate": {
    "enabled": true,
    "hashVerificationEnabled": true,
    "template": "{{#if album}}{{album}}{{else}}{{y}}/{{y}}-{{MM}}-{{dd}}{{/if}}/{{filename}}"
  },
  "passwordLogin": {
    "enabled": true
  },
  "map": {
    "enabled": true
  },
  "reverseGeocoding": {
    "enabled": true
  },
  "library": {
    "scan": {
      "enabled": true,
      "cronExpression": "*/15 * * * *"
    }
  }
}
