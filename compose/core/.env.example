# Copy to .env on the host (deploy-core.yml writes .env from env vars).
# Generate values with: ./utils/gen-app-credentials.sh --env dev --all
POSTGRES_PASSWORD=
PGADMIN_EMAIL=dev-homelabnotifications@pm.me
PGADMIN_PASSWORD=
HOMARR_SECRET_KEY=
LINKWARDEN_SECRET=
LINKWARDEN_URL=http://192.168.122.50:3001

# Profiles: auth = Authelia; media = Immich + Jellyfin
# Optional: add beszel-agent after bootstrap caches BESZEL_KEY
COMPOSE_PROFILES=auth,media

IMMICH_DB_PASSWORD=
IMMICH_VERSION=v3

JELLYFIN_URL=http://192.168.122.50:8096

# Issued by the Beszel hub during bootstrap — not generated locally.
# BESZEL_KEY=
# BESZEL_TOKEN=
BESZEL_HUB_URL=http://127.0.0.1:8090

# Zotify — interactive Spotify OAuth; see docs/kb/apps/zotify.md
# ZOTIFY_USERNAME=
# ZOTIFY_TOKEN=

AUTHELIA_JWT_SECRET=
AUTHELIA_SESSION_SECRET=
AUTHELIA_STORAGE_KEY=
NAVIDROME_ADMIN_PASSWORD=
