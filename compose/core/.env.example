# Copy to .env on the host (deploy-core.yml writes .env from env vars).
POSTGRES_PASSWORD=change-me
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change-me
HOMARR_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
LINKWARDEN_SECRET=change-me
LINKWARDEN_URL=http://192.168.122.50:3001

# Enable Authelia (compose profile `auth`)
COMPOSE_PROFILES=auth

# Zotify (optional) — Spotify login is interactive via docker exec; credentials
# are stored under the zotify_config volume after first login. No SPOTIFY_* env
# required by upstream; use: docker exec -it homelab-core-zotify-1 zotify -u <user>
# ZOTIFY_USERNAME=
# ZOTIFY_TOKEN=
