# Copy to .env on the host (deploy-core.yml writes .env from env vars).
POSTGRES_PASSWORD=change-me
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change-me
HOMARR_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
LINKWARDEN_SECRET=change-me
LINKWARDEN_URL=http://192.168.122.50:3001

# Profiles: auth = Authelia; media = Immich + Jellyfin (Syncthing/Navidrome always on)
# Optional: add beszel-agent after hub UI setup (requires BESZEL_KEY)
COMPOSE_PROFILES=auth,media

# Immich dedicated Postgres (not the shared core Postgres)
IMMICH_DB_PASSWORD=change-me
IMMICH_VERSION=v3

JELLYFIN_URL=http://192.168.122.50:8096

# Beszel agent — paste KEY from hub UI after first login (optional on DEV)
# BESZEL_KEY=
# BESZEL_TOKEN=
BESZEL_HUB_URL=http://127.0.0.1:8090

# Zotify — Spotify login is interactive via docker exec; credentials land in zotify_config volume.
# ZOTIFY_USERNAME=
# ZOTIFY_TOKEN=
